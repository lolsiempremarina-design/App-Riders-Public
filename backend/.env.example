# RoR - modello di configurazione locale (non contiene segreti reali).
# Copiare questo file in .env e sostituire tutti i valori change-me.
# Non aggiungere mai .env al repository.

# Sicurezza Flask: usare due valori casuali, distinti e lunghi almeno 48 caratteri.
SECRET_KEY=change-me-generate-a-long-random-secret
SECURITY_PASSWORD_SALT=change-me-generate-an-independent-random-salt

# PostgreSQL.
DB_USER=ror_app
DB_PASSWORD=change-me-use-a-strong-database-password
DB_NAME=ror

# RabbitMQ.
RABBITMQ_USER=ror_worker
RABBITMQ_PASSWORD=change-me-use-a-strong-rabbitmq-password
RABBITMQ_QUEUE=telemetry_stream
RABBITMQ_PORT=5672

# Redis e posizione live.
REDIS_PORT=6379
POSITION_TTL=90

# Elaborazione e archiviazione GPX (ogni punto va su disco prima della conferma a RabbitMQ).
RDP_EPSILON=0.00004
GPX_STORAGE_DIR=/data/volume_gpx_storage
OUTPUT_BASE_DIR=/data/volume_gpx_storage

# Cookie sicuri: mantenere true quando si usa HTTPS.
SESSION_COOKIE_SECURE=true
REMEMBER_COOKIE_SECURE=true

# Non abilitare il debug in ambienti condivisi o esposti.
FLASK_DEBUG=false

# Ngrok - Tunnel pubblico HTTPS (per test da smartphone/remoto)
# Registrati gratuitamente su https://dashboard.ngrok.com e recupera il tuo authtoken:
# https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Dominio statico opzionale (es. my-app.ngrok-free.app, disponibile gratuitamente su ngrok)
NGROK_DOMAIN=

# Fuso orario per statistiche e storico percorsi.
APP_TIMEZONE=Europe/Rome

# Pausa GPS: oltre questi secondi senza punti il tempo non conta come percorso.
PAUSE_GAP_SEC=120

# Email SOS ai contatti di emergenza (facoltativo: senza MAIL_SERVER non si invia nulla
# e l'app lo dice chiaramente). Esempio Gmail: smtp.gmail.com, 587, password per le app.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# ---------------------------------------------------------------------------
# PRODUZIONE (docker-compose.prod.yml, guida in DEPLOY.md)
# ---------------------------------------------------------------------------
# Dominio pubblico dell'app (record DNS A/AAAA verso il server) ed email per Let's Encrypt.
DOMAIN=
LETSENCRYPT_EMAIL=
# Dove il servizio "backup" salva ogni giorno database e GPX, e per quanti giorni li conserva.
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
# In locale lasciare vuoti: nginx accetta qualsiasi nome host con il certificato di nginx/certs.
SERVER_NAME=
SSL_CERTIFICATE=
SSL_CERTIFICATE_KEY=

# ---------------------------------------------------------------------------
# PRIVACY (GDPR): mostrati nella pagina Privacy dell'app. Vuoti = l'app dice "non configurato".
# ---------------------------------------------------------------------------
PRIVACY_CONTROLLER_NAME=
PRIVACY_CONTACT_EMAIL=
# Tempi di conservazione in giorni, applicati ogni giorno da `flask ror purge-expired`
# (servizio "maintenance" in produzione). 0 = finché l'utente non li elimina.
ROUTE_RETENTION_DAYS=0
NOTIFICATION_RETENTION_DAYS=180
SOS_RETENTION_DAYS=365
CHAT_RETENTION_DAYS=365

# App Android (fase 7). Notifiche push: chiave in secrets/firebase-service-account.json (docker-compose.yml
# imposta FCM_SERVICE_ACCOUNT_FILE). Token push non confermati dall app da tanti giorni: cancellati da purge-expired.
PUSH_TOKEN_STALE_DAYS=60
# App Links: impronte SHA-256 dei certificati che firmano l APK, separate da virgole
# (keytool -list -v -keystore android/keystore/ror-release.jks -alias ror). Vuoto = /.well-known/assetlinks.json 404.
ANDROID_APP_ID=com.ror.rider
ANDROID_CERT_SHA256=
