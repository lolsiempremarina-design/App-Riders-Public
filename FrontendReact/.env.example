# URL base delle API REST. Con Nginx (Docker) frontend e backend sono sullo stesso dominio.
VITE_API_URL=/api

# URL base dei WebSocket. Vuoto = stesso dominio della pagina (wss://<host>/ws/...).
VITE_WS_URL=

# Solo per `npm run dev`: dove il proxy di Vite inoltra /api, /stream, /session e /ws.
# Di default punta a Nginx avviato con docker compose (https://localhost).
VITE_DEV_BACKEND_URL=https://localhost

# App Android (Capacitor): indirizzo che l app apre (tunnel ngrok o dominio), usato da npm run android:sync
CAP_SERVER_URL=https://nome.ngrok-free.dev
